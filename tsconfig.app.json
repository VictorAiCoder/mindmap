{
  "extends": "@vue/tsconfig/tsconfig.dom.json",
  "include": [
    "env.d.ts",
    "src/**/*",
    "src/**/*.vue"
, "vitest.config.ts"  ],
  "exclude": ["src/**/__tests__/*"],
  "compilerOptions": {
    "composite": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",

    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@features/*": ["./src/features/*"],
      "@shared/*": ["./src/shared/*"]
    },

    /* ★ Миграция с JS — разрешаем оба языка */
    "allowJs": true,
    "checkJs": false,

    /* ★ Умеренная строгость */
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    // "noUnusedLocals": true,        // ← может подсветить мёртвый код
    // "noUnusedParameters": true,    // ← тож

    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "resolveJsonModule": true,

    /* ★ Для Vuetify — нужен isolatedModules */
    "isolatedModules": true,
    "verbatimModuleSyntax": true
  }
}